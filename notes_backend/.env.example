# Environment variables required for notes_backend

# --- Database connection ---
POSTGRES_URL=postgresql://notes_user:notes_password@notes_db:5432/notes_db
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=notes_password
POSTGRES_DB=notes_db
POSTGRES_PORT=5432

# --- Security/Authentication ---
# Change before deploying to production!
SECRET_KEY=change_this_in_prod_to_random_secret

# Optionally configure other FastAPI/uvicorn settings as needed.

# For other containers, ensure these match your docker/docker-compose config.
